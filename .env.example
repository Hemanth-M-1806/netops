# ==============================================================
# Router Telemetry & AI Copilot — environment template
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# ==============================================================

APP_ENV=development
APP_NAME=Router Telemetry & AI Copilot
LOG_LEVEL=INFO
API_PORT=8000
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# ---- Database (MySQL 8.0) ----
MYSQL_USER=netops
MYSQL_PASSWORD=netops
MYSQL_DATABASE=netops
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=netops
# SQLAlchemy async DSN (aiomysql driver)
DATABASE_URL=mysql+aiomysql://netops:netops@localhost:3306/netops
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- Auth (modular, off by default for the DBMS demo) ----
AUTH_ENABLED=false
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- AI / LLM provider abstraction ----
# mock | openai | ollama | local | openrouter
LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen3.8-27b:free
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
PROMPT_VERSION=v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_URL=http://localhost:9000

# ---- Anomaly detector abstraction ----
# mock | isolation_forest | external
ANOMALY_DETECTOR=mock
ML_SERVICE_URL=
ANOMALY_DROP_SIGMA=3.0
ANOMALY_ERROR_SIGMA=3.0

# ---- Cache ----
CACHE_TTL_SECONDS=3600
CACHE_MAX_CONTEXT_METRICS=50
CACHE_MAX_CONTEXT_ALERTS=10

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=120

# ---- Collection layer (dev-only microservice) ----
COLLECTOR_HOST=0.0.0.0
COLLECTOR_PORT=8100
COLLECTOR_SOURCES=push
COLLECTOR_FORWARDER=backend
COLLECTOR_FORWARD_URL=http://localhost:8000/api/v1/telemetry/ingest
COLLECTOR_BATCH_SIZE=200
COLLECTOR_POLL_INTERVAL_SECONDS=30
COLLECTOR_TIMEOUT_SECONDS=10
COLLECTOR_MAX_RETRIES=3
COLLECTOR_RETRY_BACKOFF_SECONDS=0.5
COLLECTOR_DRY_RUN=false
COLLECTOR_LOG_LEVEL=INFO
COLLECTOR_API_KEY=

# ---- Simulator (dev only) ----
SIMULATOR_API_BASE_URL=http://localhost:8000/api/v1
SIMULATOR_COLLECTOR_URL=http://localhost:8100/ingest
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_ENABLED=false
SIMULATOR_LOG_LEVEL=INFO
SIMULATOR_DEFAULT_SCENARIO=mixed
SIMULATOR_ALLOW_SYNTHETIC_TOPOLOGY=true
# Browsable status endpoint served while a run is active (/, /status, /health)
SIMULATOR_HOST=0.0.0.0
SIMULATOR_PORT=8200
SIMULATOR_STATUS_ENABLED=true

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/telemetry
